#!/bin/sh
# Git hooks run in every worktree. Only deploy a clean main checkout on the
# deploy branch; tools/main-checkout explains a checkout left on master.
set -eu
cd "$(dirname "$0")/.."
tools/main-checkout || exit 0
if [ -n "$(git status --porcelain)" ]; then
  echo 'schedule-send: automatic install skipped; the main checkout has uncommitted changes.' >&2
  exit 0
fi
source_id="$(tools/source-id)"
installed_id=""
[ ! -f bin/.installed-source ] || installed_id="$(cat bin/.installed-source)"
[ ! -x bin/schedule-send ] || [ "$source_id" != "$installed_id" ] || exit 0
if ! tools/install; then
  echo 'schedule-send: automatic install failed; run tools/install to retry.' >&2
fi
