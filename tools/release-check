#!/bin/sh
# Check that a version is ready to release, and print its changelog section,
# which becomes the release notes. The tag, the changelog, and the Herdr
# plugin's manifest must all carry the version.
#
#   tools/release-check 1.2.3        (a leading v is ignored)
set -eu
[ "$#" -eq 1 ] || { echo 'Usage: tools/release-check VERSION' >&2; exit 1; }
version="${1#v}"
cd "$(dirname "$0")/.."
die() {
  echo "release-check: $*" >&2
  exit 1
}

printf '%s\n' "$version" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?' ||
  die "$version is not a version such as 1.2.3 or 1.2.3-rc.1."

manifest="$(sed -n 's/^version = "\(.*\)"$/\1/p' herdr-plugin.toml)"
[ "$manifest" = "$version" ] || die "herdr-plugin.toml has version ${manifest:-none}, not $version."

# Exactly one heading "## [VERSION] - YYYY-MM-DD", and something under it
# before the next "## [" heading.
headings="$(awk -v v="$version" 'index($0, "## [" v "] - ") == 1 { n++ } END { print n + 0 }' CHANGELOG.md)"
[ "$headings" -eq 1 ] || die "CHANGELOG.md has $headings sections for $version; it needs one, headed \"## [$version] - <date>\"."
awk -v v="$version" 'index($0, "## [" v "] - ") == 1 { print substr($0, length("## [" v "] - ") + 1) }' CHANGELOG.md |
  grep -Eqx '[0-9]{4}-[0-9]{2}-[0-9]{2}' || die "the CHANGELOG.md heading for $version needs a date, as YYYY-MM-DD."
notes="$(awk -v v="$version" '
  /^## \[/ { if (on) exit; if (index($0, "## [" v "] - ") == 1) { on = 1; next } }
  on { print }
' CHANGELOG.md)"
printf '%s\n' "$notes" | grep -q '[^[:space:]]' || die "the CHANGELOG.md section for $version is empty."

# Without the blank lines at either end.
printf '%s\n' "$notes" | awk 'NF { for (; blank > 0; blank--) print ""; print; started = 1; next } started { blank++ }'
