#!/bin/sh
# Build and activate only from the master checkout: timer paths must survive
# removal of feature worktrees. Publish the binary atomically after a full build.
set -eu
cd "$(dirname "$0")/.."
root="$(pwd -P)"
common="$(git rev-parse --path-format=absolute --git-common-dir)"
branch="$(git symbolic-ref --quiet --short HEAD)"
if [ "$root/.git" != "$common" ] || [ "$branch" != master ]; then
  echo 'Run tools/install from the main checkout on master.' >&2
  exit 1
fi
mkdir -p bin
build_tmp="$(mktemp "$root/bin/.schedule-send.XXXXXX")"
trap 'rm -f "$build_tmp"' EXIT HUP INT TERM
go build -trimpath -o "$build_tmp" ./cmd/schedule-send
mv -f "$build_tmp" "$root/bin/schedule-send"
mkdir -p "$HOME/.local/bin"
ln -sfn "$root/bin/schedule-send" "$HOME/.local/bin/schedule-send"
echo "installed $HOME/.local/bin/schedule-send -> $root/bin/schedule-send"
