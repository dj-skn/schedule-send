#!/bin/sh
# The verification gate: formatting, vet, tests, and the zsh shim's syntax.
set -eu
cd "$(dirname "$0")/.."

unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  echo "gofmt would change:" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...
go test -count=1 ./...
zsh -n schedule-send.zsh
for script in tools/build tools/install tools/main-checkout tools/setup-hooks tools/source-id tools/auto-install tools/test-hooks .githooks/*; do
  sh -n "$script"
done
tools/test-hooks
echo "check: ok"
