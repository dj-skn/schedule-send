#!/bin/sh
# The verification gate: formatting, vet, tests, and the zsh shim's syntax.
set -eu
cd "$(dirname "$0")/.."

unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  echo "gofmt would change:" >&2
  echo "$unformatted" >&2
  exit 1
fi
# Every action runs at a full commit with its version beside it, which
# Dependabot keeps current; GitHub refuses the rest. A workflow of this
# repository is named by its path.
unpinned="$(grep -rn -E '^[[:space:]-]*uses:' .github | grep -v -E 'uses:[[:space:]]+(\./|[^@[:space:]]+@[0-9a-f]{40} # v[0-9])' || true)"
if [ -n "$unpinned" ]; then
  echo "Actions not pinned to a full commit with its version beside it:" >&2
  echo "$unpinned" >&2
  exit 1
fi
# Each system's scheduler is its own file, so vet both; only one can run here.
GOOS=linux go vet ./...
GOOS=darwin go vet ./...
go test -count=1 ./...
zsh -n schedule-send.zsh
for script in tools/build tools/install tools/check-trailers tools/main-checkout tools/setup-hooks tools/source-id tools/auto-install tools/test-hooks tools/launchd-smoke tools/dist tools/install-smoke tools/brew-smoke tools/plugin-smoke tools/release tools/release-check tools/test-release tools/bump-tap tools/test-bump-tap tools/vulncheck tools/media plugin/find.sh plugin/schedule.sh plugin/prompt.sh plugin/setup.sh install.sh testdata/standin/launchctl .githooks/*; do
  sh -n "$script"
done
tools/test-hooks
tools/test-release
tools/test-bump-tap
echo "check: ok"
