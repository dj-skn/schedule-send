# Resume after a usage limit: the picker puts the limited agent first, Enter
# takes it, and Enter again schedules "resume" a minute after the reset.
# Recorded by tools/media.
Output out/resume.gif

Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 20
Set Width 1500
Set Height 760
Set Padding 24
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set BorderRadius 10
Set Margin 24
Set MarginFill "#45475a"
Set TypingSpeed 55ms

Hide
Type "source /work/env.sh && clear"
Enter
Show

Sleep 600ms
Type "schedule-send"
Sleep 500ms
Enter
Sleep 2.4s
Enter
Sleep 3.2s
Enter
Sleep 5s
