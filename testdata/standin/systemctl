#!/bin/sh
# A stand-in for systemctl that arms nothing. Calls are appended to
# $SYSTEMCTL_STANDIN_LOG when it is set. is-active answers active only for the
# unit named in $SYSTEMCTL_STANDIN_ACTIVE.
[ -n "${SYSTEMCTL_STANDIN_LOG:-}" ] && printf '%s\n' "$*" >> "$SYSTEMCTL_STANDIN_LOG"
[ "${1:-}" = --user ] && shift
case "${1:-}" in
  is-system-running) echo running ;;
  is-active)
    if [ -n "${SYSTEMCTL_STANDIN_ACTIVE:-}" ] && [ "${2:-}" = "$SYSTEMCTL_STANDIN_ACTIVE" ]; then
      echo active
      exit 0
    fi
    echo inactive; exit 3 ;;
  status) echo "stand-in status for $2" ;;
esac
exit 0
